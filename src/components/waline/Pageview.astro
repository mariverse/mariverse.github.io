---
import { integ } from '@/site-config'
---

{integ.waline.enable && <waline-pageview data-server={integ.waline.server} hidden />}

<script>
  import { pageviewCount } from '@waline/client/pageview'

  import { getWalinePath } from './path'

  customElements.define('waline-pageview', class extends HTMLElement {
    connectedCallback() {
      const serverURL = this.dataset.server
      if (serverURL) pageviewCount({ serverURL, path: getWalinePath(location.pathname) })
    }
  })
</script>
