---
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import avatar from '@/assets/avatar.jpg'
import config from '@/site-config'

const generalProgramming = ['MATLAB', 'C', 'Rust', 'JavaScript/TypeScript', 'AI']
const developmentTools = ['Windows', 'VSCode', 'Git', 'WSL2', 'Fish Shell', 'Nanovim', 'OpenCode']
const designTools = ['Figma', 'Excalidraw', 'Obsidian', 'AI']
const others = ['Markdown', 'LaTeX']

const MAX_POSTS = 5
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='profile'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='China / JiangXi (赣)'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title='GitHub' as='a' href='https://github.com/mariverse' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground mt-1'>Engineer / Omnivorous / Son / Study Forever</p>
        <div class='flex flex-col gap-2 leading-6 text-muted-foreground'>
          <p>你好，我是邹海达，是一个兴趣广泛、热爱硬件的工程师。</p>
          <p>我是杂事爱好者，兴趣广泛，包括电路设计绘图、硬件调试、信号处理方向。</p>
          <p>我喜欢羽毛球、夜跑、阅读。每月跑量不少于 5km。</p>
          <p>如果你对我感兴趣，或正在寻求帮助，欢迎联系我！</p>
          <div class='mt-1 flex gap-x-2'>
            <a href='https://wakatime.com/@94eb477c-75cd-47c9-9786-cd85b67c563d'
              ><img
                src='https://wakatime.com/badge/user/94eb477c-75cd-47c9-9786-cd85b67c563d.svg?style=default'
                alt='Total time coded since May 17 2026'
              /></a
            >
          </div>
        </div>
        <Button title='More about me' class='w-fit self-end' href='/about' style='ahead' />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Posts'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }

      {
        (
          <Section title='Occupation'>
            <Card
              heading='医工学人'
              subheading='理事会/技术顾问'
              date='Apr 2024 - May 2025'
            >
              <img
                class='absolute end-2 top-2 z-0 h-25 w-auto object-contain opacity-40'
                src='https://yigongxueren.com/wp-content/uploads/2025/03/New-logo-202410-1-09-s80.png'
              />
              <ul class='ms-4 list-disc text-muted-foreground'>
                <li>
                  AI 自动化数据管线与多模态应用落地
                  <ul class='ms-4 list-disc'>
                    <li>
                      基于 Coze 搭建生物医学工程领域 AI 内容生产工作流，实现专业内容重构及多模态发布自动化。
                    </li>
                    <li>
                      编写 Prompt（提示词工程）完成垂类技术内容精炼，接入多模态 API 自动生成音频及视觉封面，支撑播客《医工学人》累计发布 280+ 期内容。
                    </li>
                  </ul>
                </li>

                <li>
                  前沿技术跟踪与文献体系建设
                  <ul class='ms-4 list-disc'>
                    <li>
                      持续跟踪 10+ 顶尖学术期刊数据库，解读生物医学工程领域前沿科研成果并建设<a href="https://yigongxueren.feishu.cn/wiki/P9LSwrvCjiewcUk1Byscz8VBn4e">技术知识库</a>。
                    </li>
                    <li>
                      产业视角梳理关键技术指标，建立专家链接，主导 20+ 场 HIT Webinar 学术主题策划，报告均<a href="https://space.bilibili.com/121268500">公开发布于 Bilibili</a>
                    </li>
                  </ul>
                </li>

                <li>参与制定组织架构与发展战略</li>
              </ul>
            </Card>

            <Card
              heading='深圳市安保医疗科技股份有限公司'
              subheading='科研部/学术研究员（核心技术骨干）'
              date='July 2022 - Mar 2024'
            >
              <img
                class='absolute end-2 top-2 z-0 h-25 w-auto object-contain opacity-40'
                src='https://www.amoulmed.com/Uploads/config/62e73d9c60349.png'
              />
              <ul class='ms-4 list-disc text-muted-foreground'>
                <li>
                  技术调研与需求定义
                  <ul class='ms-4 list-disc'>
                    <li>
                      深度调研同类竞品，对标国际行业标杆，系统性收集并分析竞品关键技术与临床指标。
                    </li>
                    <li>
                      将临床需求转化为清晰的工程研发指标，为主导的医疗设备整机设计与核心算法迭代确定方向支撑。
                    </li>
                  </ul>
                </li>

                <li>
                  研发小组攻关与跨单位学术协同
                  <ul class='ms-4 list-disc'>
                    <li>
                      主导电阻抗断层成像（EIT）图像重建算法验证，建立测试规范并完成人体实时成像验证。
                    </li>
                    <li>
                      负责与南京航空航天大学姚佳烽课题组的产学研协同对接，联合攻关有限元模型构建与算法正逆问题求解。
                    </li>
                  </ul>
                </li>

                <li>
                  产品化转化与注册合规支持
                  <ul class='ms-4 list-disc'>
                    <li>
                      联合设计团队定制上位机 UI 交互方案，负责技术指标到软件功能的端到端落地与功能验证。
                    </li>
                    <li>
                      全程参与样机原型从算法验证到工程合规测试的转化全链路，该研究成果获批
                      <a href='https://www.nmpa.gov.cn/datasearch/home-index.html#category=ylqx'>
                        <strong>国家二类医疗器械注册证（粤械注准20242071568）</strong>
                      </a>
                    </li>
                  </ul>
                </li>
              </ul>
            </Card>
          </Section>
        )
      }
      <Section title='Education'>
        <Card
          as='a'
          heading='西安交通大学'
          subheading='生物医学工程'
          date='Sep 2018 - July 2022'
          href='https://xjtu.edu.cn/'
        >
          <img
            class='absolute end-0 z-0 m-0 -my-3 h-full w-1/2 object-cover opacity-40'
            src='/images/XJTU.svg'
          />
        </Card>
        <Card
          as='a'
          heading='江西省抚州市第一中学'
          subheading=' '
          date='Sep 2012 - June 2018'
          href='https://jxfzyz.net/'
        >
          <img
            class='absolute end-0 z-0 m-0 -my-3 h-full w-1/2 object-cover opacity-40'
            src='/images/FZYZ.svg'
          />
        </Card>
      </Section>

      <!-- <Section title='Website List'>
        <div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
          <ProjectCard
            href='https://www.youtube.com/watch?v=dQw4w9WgXcQ'
            heading='Lorem ipsum'
            subheading='dolor sit amet, oratio ornatus explicari pro ex'
            imagePath='/src/assets/projects/alex-tyson-2BAXJ7ha74s-unsplash.jpg'
          />
