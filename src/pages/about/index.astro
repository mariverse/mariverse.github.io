---
import config from 'virtual:config'

import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import Signature from '@/components/Signature.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import flclash from '@/assets/tools/flclash.png'
import zotero from '@/assets/tools/zotero.png'

const headings = [
  {
    depth: 2,
    slug: 'tools',
    text: 'Tools'
  },
  {
    depth: 2,
    slug: 'social-networks',
    text: 'Social Networks'
  },
  {
    depth: 2,
    slug: 'education',
    text: 'Education'
  },
  {
    depth: 2,
    slug: 'experience',
    text: 'Experience'
  },
  {
    depth: 2,
    slug: 'about-blog',
    text: 'About Blog'
  }
]
---

<PageLayout title='About' {headings} comment>
  <h2 id='general-talk' class='invisible m-0 h-0'>General Talk</h2>
  <p class='text-muted-foreground'>Developer / Designer / <del>Medical student </del></p>
  <p>你好，我是邹海达，是一个兴趣使然、热爱编程的医学生。</p>
  <p>是的，Mariverse 就是我给自己取的用户名字。</p>
  <div class='flex w-fit gap-x-2'>
    <!-- <img
      src='https://hits.seeyoufarm.com/api/count/incr/badge.svg?url=https%3A%2F%2Fgithub.com%2Fzhuozhiyongde&count_bg=%23000000&title_bg=%23000000&icon=spacex.svg&icon_color=%23E7E7E7&title=Hits&edge_flat=true'
      class='my-0 rounded-md border'
    /> -->
  </div>

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>以下是我正在使用的一些工具：</p>
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Arc',
        description: 'Broswer',
        href: 'https://arc.net/',
        icon: import('@/assets/tools/arc.svg?raw')
      },
      {
        name: 'Flclash',
        description: 'Proxy Client',
        href: 'https://github.com/chen08209/FlClash',
        icon: flclash
      },
      {
        name: 'Obsidian',
        description: 'Markdown Editor',
        href: 'https://obsidian.md/',
        icon: import('@/assets/tools/obsidian.svg?raw')
      },
      {
        name: 'Zotero',
        description: 'Reference Management',
        href: 'https://www.zotero.org/',
        icon: zotero
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'OpenCode',
        description: 'The open source AI coding agent',
        href: 'https://opencode.ai/',
        icon: import('@/assets/tools/opencode-logo-light.svg?raw'),
        darkIcon: import('@/assets/tools/opencode-logo-dark.svg?raw')
      },
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Windows Terminal & WSL2 Debian 12',
        description: 'Terminal',
        href: 'https://learn.microsoft.com/windows/terminal/',
        icon: import('@/assets/tools/terminal.svg?raw')
      },
      {
        name: 'Zen',
        description: 'Privacy Browser',
        href: 'https://zen-browser.app/',
        icon: import('@/assets/tools/zen-light.svg?raw'),
        darkIcon: import('@/assets/tools/zen-dark.svg?raw')
      }
    ]}
  />
