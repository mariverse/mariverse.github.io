---
import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.png'
import KeyIcon from '@/assets/icons/key.svg'
import wechat from '@/assets/wechat-qrcode.png'

const headings = [
  { depth: 2, slug: 'theme', text: 'Theme' },
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  // { depth: 2, slug: 'others', text: 'Others' },
  { depth: 2, slug: 'gpg-signature', text: 'GPG Signature' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} comment>
  <p>如果你认为我的工作很有用或有趣，您可以捐赠以支持我的工作，或联系我讨论项目。</p>
  <Button title='赞赏我的工作' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='theme'>Theme</h2>
  <ProjectSection
    projects={[
      {
        name: '🍭 Astro-theme-pure',
        description: 'A simple, clean but powerful blog theme build by astro.',
        links: [
          { type: 'github', href: 'https://github.com/cworld1/astro-theme-pure' },
          { type: 'site', href: 'https://github.com/cworld1/astro-theme-pure' },
          {
            type: 'doc',
            href: 'https://github.com/cworld1/astro-theme-pure/blob/main/src/content/blog/customize/index.md'
          }
        ]
      },
      {
        // https://github.com/zhuozhiyongde/VSCode-Markdown-Theme
        name: '🌈 VSCode Markdown Theme',
        description: 'A markdown theme for VSCode.',
        links: [{ type: 'github', href: 'https://github.com/zhuozhiyongde/VSCode-Markdown-Theme' }]
      }
    ]}
  />

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '💄 PKU Art',
        description: '简洁优雅的北大教学网、选课网美化方案',
        links: [
          { type: 'site', href: 'https://arthals.ink/blog/pku-art' },
          { type: 'github', href: 'https://github.com/zhuozhiyongde/pku-art' },
          { type: 'doc', href: 'https://docs.arthals.ink/docs/pku-art' }
        ]
      },
      {
        name: '🤖 PKU Auto Elective',
        description: '北京大学刷课机',
        links: [
          { type: 'github', href: 'https://github.com/zhuozhiyongde/PKUElective2024Spring' },
          { type: 'doc', href: 'https://docs.arthals.ink/docs/pku-auto-elective' }
        ]
      }
    ]}
  />
  <!-- <Collapse title='Some old projects'>
    <ProjectSection
      projects={[
        {
          name: 'Search Switcher',
          description: 'Add links to each other in search engines',
          links: [{ type: 'github', href: 'https://github.com/cworld1/search-switcher' }]
        },
        {
          name: 'Pure Baidu',
          description: 'Baidu search page beautification module',
          links: [
            { type: 'doc', href: 'https://cworld0.com/blog/pure-baidu' },
            { type: 'site', href: 'https://userstyles.org/styles/173673/pure' }
          ]
        }
      ]}
    />
  </Collapse> -->

  <h2 id='learnings'>Recommendations</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: '计算机系统导论 / ICS',
        description: '北京大学 2023 年秋季计算机系统导论课程笔记、代码、往年题和经验',
        links: [
          {
            type: 'github',
            href: 'https://github.com/zhuozhiyongde/Introduction-To-Computer-System-2023Fall-PKU'
          }
        ]
      },
      {
        name: '高等数学 B / 高数 B',
        description: '北京大学 2022 年高等数学 B 课程笔记、往年题和经验',
        links: [
          {
            type: 'github',
            href: 'https://github.com/zhuozhiyongde/Advanced-Mathematics-B-2022-PKU'
          }
        ]
      },
      {
        name: '信息学中的概率统计 / 信概统',
        description: '北京大学 2024 年秋季信息学中的概率统计课程笔记、作业、往年题和经验',
        links: [
          {
            type: 'github',
            href: 'https://github.com/zhuozhiyongde/Probability-Theory-and-Statistics-2024Fall-PKU'
          }
        ]
      },
      {
        name: '具身智能导论 / EAI 导论',
        description: '北京大学 2025 年春季具身智能导论课程笔记、作业、往年题和 CheatSheet',
        links: [
          {
            type: 'github',
            href: 'https://github.com/zhuozhiyongde/Embodied-Artificial-Intelligence-2025Spring-PKU'
          }
        ]
      }
    ]}
  />

  <!-- <h2 id='others'>Others</h2>
  <ProjectSection
    projects={[
      {
        name: 'CWorld',
        description: "CWorld's Github",
        links: [{ type: 'github', href: 'https://github.com/cworld1' }]
      },
      {
        name: 'Arthals',
        description: 'Arthals Github',
        links: [{ type: 'github', href: 'https://github.com/zhuozhiyongde' }]
      }
    ]}
  /> -->

  <!-- gpg signature -->
  <h2 id='gpg-signature'>GPG Signature</h2>
  <p>
    你可以通过检查 GPG 签名来验证我签名的文件的真实性。我的 GPG 密钥是 <code
      >CC30E2C29D5114489FD60B02A0DADBEB9F897A62</code
    >，你可以在 openpgp 密钥服务器上找到它或从那里下载。
  </p>
  <Button
    href='https://keys.openpgp.org/search?q=CC30E2C29D5114489FD60B02A0DADBEB9F897A62'
    title='验证密钥'
    target='_blank'
  >
    <KeyIcon class='size-5' slot='before' />
  </Button>

  <!-- sponsorship -->
  <h2 id='sponsorship'>赞赏</h2>
  <p>感谢您的赞赏，您的支持是我最大的动力。</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <!-- <p>Thanks to the following sponsors:</p>
  <Sponsors
    sponsors={[
      { name: 'C*a（酷安@暴走の蜗牛）', amount: '2.00', date: '2019-07-02' },
      { name: '华雄(QQ：1300****71)', amount: '5.00', date: '2019-12-30' },
      { name: '◌(QQ：1934****45)', amount: '3.00', date: '2019-12-30' },
      { name: 'Anonymous', amount: '20.00', date: '2022-04-06' }
    ]}
  /> -->
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
